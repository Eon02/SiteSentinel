# Copy to .env and fill in. Never commit .env.
#
# Supabase: Project Settings -> Database -> Connection string -> "Session pooler".
# Use the session pooler (port 5432 on *.pooler.supabase.com): it works on IPv4
# networks, unlike the direct connection on the free tier.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# Comma-separated list of origins allowed to call the API (frontend dev servers).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Next-day safety briefings (6 PM site-local). Leave BRIEFINGS_ENABLED=false on dev machines;
# enable it in exactly one deployed instance so it is the one that sends the team's briefings.
BRIEFINGS_ENABLED=false
# Where each briefing is POSTed as JSON. Unset = briefings are built and stored but not sent.
BRIEFING_WEBHOOK_URL=
# Optional; sent as "Authorization: Bearer <token>".
BRIEFING_WEBHOOK_TOKEN=

# Conditions worker: records each site's current weather into the conditions table every
# CONDITIONS_INTERVAL_S seconds. Like briefings, enable it in one deployed instance only.
CONDITIONS_ENABLED=false
CONDITIONS_INTERVAL_S=900

# Automated flood checks: keep flood alerts current for the dashboard. Sends no texts.
# Leave false on dev machines; enable in exactly one deployed instance.
FLOOD_CHECKS_ENABLED=false

# Outgoing SMS for flood warnings (Twilio). Find the SID and token on the Twilio console home
# page. Trial accounts can only text verified numbers. Set FROM_NUMBER or MESSAGING_SERVICE_SID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Trial accounts only: send this predefined template instead of the warning text.
# TWILIO_BODY_TEMPLATE=sms_internal_alerts
